# OpenRouter API key (used for LLM Dreaming via OpenAI-compatible API).
# Copy to .env and fill in your key:
#   cp .env.example .env
#
# The codebase reads OPENAI_API_KEY (historical name — works with OpenRouter).
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional overrides for dreaming experiments (run_extensions.py picks these up)
DREAM_BASE_URL=openrouter
DREAM_MODEL=deepseek/deepseek-chat-v3-0324
DREAM_N_TURNS=2
